<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= publicacion.titulo %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
  </head>
  <body>
    <nav class="navbar navbar-expand-lg bg-secondary bg-opacity-75">
      <div class="container-fluid">
        <a class="navbar-brand" href="/index">WeDo</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <a class="nav-link active" aria-current="page" href="/index">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/publicaciones">Publicaciones</a>
            </li>
          </ul>
        </div>
      </div>
  </nav>

  <div class="container d-flex justify-content-center">
    <div class="row">
      <div class="card">
          <div class="row">
              <div class="col-6"> <!-- Ajusta el tamaño de la columna del carrusel -->
                  <div id="carouselExample" class="carousel slide">
                      <div class="carousel-inner">
                          <% imagenes.forEach((imagen, index) => { %>
                              <div class="carousel-item <%= index === 0 ? 'active' : '' %>"> <!-- Cambia 'active' en la primera imagen -->
                                  <img src="data:image/jpeg;base64,<%= imagen.toString('base64') %>" 
                                       alt="<%= publicacion.titulo %>" 
                                       class="img-fluid" style="max-width: 100%; height: auto;">
                              </div>
                          <% }) %>
                      </div>
                      <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                          <span class="visually-hidden">Previous</span>
                      </button>
                      <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                          <span class="carousel-control-next-icon" aria-hidden="true"></span>
                          <span class="visually-hidden">Next</span>
                      </button>
                  </div>
              </div>
              
              <div class="col-6"> <!-- Ajusta el tamaño de la columna de información -->
                  <div class="card-body">
                      <h4 class="card-title"><%= publicacion.titulo %></h4>
                      <br>
                      <p class="card-text"><%= publicacion.descripcion %></p>
                      <br>
                      <p class="card-text">Precio Estimado: <%= publicacion.precio_estimado %></p>
                  </div>
              </div>
          </div>
          <div>
            <%if (empresa === true) { %>
                <form action="/cotizar_publicacion" method="POST"> 
                  <input type="hidden" name="publicacion_id" value="<%= publicacion.id %>">
                  <label for="cotizacion" class="form-label">Ingresa valor cotizacion</label>
                  <input class="form-control" name="valor_oferta" placeholder="Monto de cotizacion">
                  <button type="submit" class="btn btn-primary">Enviar cotizacion</button>
                </form>    
              <% } %>   
          </div>
      </div>
  </div>
</div>
<!-- Aqui Cierra el contendor del detalle de publicacion -->
  <div class="container text-center">
    <div class="row align-items-center">
      <div class="col">
        <h1>Historial de ofertas</h1>
      </div>
    </div>
  </div>

  <div class="container d-flex justify-content-center">
    <div class="row d-flex flex-column align-items-center">
      <% historial_publicacion.forEach(function(publicacion_h) { %>
        <div class="w-75 mb-3">
          <div class="card mb-3" style="max-width: 540px;">
            <div class="row g-0">
              <div class="col-md-4">
                <img src="/foto_empresa/<%= publicacion_h.id_empresa %>" class="img-fluid rounded-start" alt="<%= publicacion.nombre_empresa %>">
              </div>
              <div class="col-md-8">
                <div class="card-body">
                  <h5 class="card-title"><%= publicacion_h.nombre_empresa %></h5>
                  <p class="card-text"><%= publicacion_h.valor_oferta %></p>
                  <%if (idUsuario === publicacion.id_cliente) { %>
                    <p class="card-text">
                      <button type="button" class="btn btn-success"><a style="color: white; text-decoration: none;">Aceptar oferta</a></button>
                    </p>
                    <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4" crossorigin="anonymous"></script>
  </body>

</html>