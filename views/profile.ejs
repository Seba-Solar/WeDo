<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Bootstrap demo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  </head>
  <body>
    <!-- Main Navbar -->
    <nav class="navbar navbar-expand-lg bg-secondary bg-opacity-75">
      <div class="container-fluid">
        <a class="navbar-brand" href="/index">WeDo</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <a class="nav-link active" aria-current="page" href="/index">Home</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/publicaciones">Publicaciones</a>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Layout con Grid para Navbar Lateral -->
    <div class="container d-flex justify-content-center ">
      <div class="row">        
        <!-- Contenido principal -->
        <div class="col-md-12">
          <div class="p-3">
            <div class="container-fluid text-center">
              <div class="row align-items-center">
                <div class="col-4">
                  <img src="https://static.vecteezy.com/system/resources/thumbnails/000/495/460/small/22_Profile.jpg" class="rounded mx-auto d-block" alt="" id="imagen_p">
                  <div class="input-group ">
                    <input type="file" class="form-control" name="foto" id="foto" accept="image/*">
                  </div>
                </div>
                <div class="col-4 px-3">
                  <form action="" method="post" class="">
                      <label>Cambia tu nombre</label>
                      <input type="text" name="nombre" id="nombre">
                      <label>Cambia tu correo</label>
                      <input type="email" name="correo" id="correo">
                      <label>Cambiar Direccion</label>
                      <input type="text" name="direccion" id="direccion">
                      <label>Cambiar Telefono</label>
                      <input type="text" name="telefono" id="telefono">
                      <label>Cambia tu contraseña</label>
                      <input type="password" name="password" id="password">
                      <div class="">
                          <button type="submit" class="btn btn-primary">Guardar</button>
                          <button class="btn btn-danger"><a href="/logout">Cerrar sesion</a></button>
                      </div>
                  </form>
                </div>
              </div>
            </div>
          </div>
          
          <div class="container px-5 text-center">
            <div class="p-2">
              <h5>Publicaciones Activas</h5>
            </div>
            <div>
              <% publicacionesRelacionadas.forEach(publicacion => { %>
                <div class="container d-flex justify-content-center">
                  <div class="row w-75 mb-3">
                    <div class="card p-0" style="max-width: 540px;">
                      <div class="row g-0">
                        <div class="col-md-4">
                          <img src="/imagen/<%= publicacion.id %>" class="img-fluid rounded-start" alt="<%= publicacion.titulo %>" style="width: 100%; height: 100%; object-fit: cover; display: block;">
                        </div>
                        <div class="col-md-8">
                          <div class="card-body">
                            <h5 class="card-title"><%= publicacion.titulo %></h5>
                            <p class="card-text"><%= publicacion.descripcion %></p>
                            <p class="fst-italic"><%= publicacion.precio_estimado %></p>
                            <button type="button" class="btn btn-primary">
                              <a href="/publicacion/detalle/<%= publicacion.id %>" style="color: white; text-decoration: none;">Ver Publicacion</a>
                            </button>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% }); %>
              
              
            </div>
          </div>
        </div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="/js/profile.js">
      console.log(publicacionesRelacionadas);
    </script>
  </body>
</html>
